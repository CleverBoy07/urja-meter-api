# Copy to .env and fill in. .env is git-ignored.
URJA_PORTAL_URL=https://urja-ops.flockenergy.tech
URJA_USERNAME=
URJA_PASSWORD=

# Optional: comma-separated keys clients must send as X-API-Key. Empty = open (local dev).
URJA_API_KEYS=

# Portal politeness (portal allows ~120 req/min per session).
URJA_PORTAL_RATE_PER_MINUTE=90
URJA_PORTAL_CONCURRENCY=4

# Freshness (seconds)
URJA_INVENTORY_TTL_S=900
URJA_READINGS_RECENT_TTL_S=600
URJA_READINGS_CLOSED_TTL_S=86400

# Background crawl of recent readings for every meter (powers /v1/insights)
URJA_WARM_READINGS=true
URJA_WARM_RATE_PER_MINUTE=30

# SQLite index location (":memory:" for no persistence)
URJA_DB_PATH=data/urja.sqlite
